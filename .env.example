# Copy to .env; never commit real credentials.
TEMIS_LAB_GOOGLE_CLIENT_ID=
TEMIS_LAB_GOOGLE_CLIENT_SECRET=
TEMIS_LAB_GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback
TEMIS_LAB_NAVER_CLIENT_ID=
TEMIS_LAB_NAVER_CLIENT_SECRET=
TEMIS_LAB_NAVER_REDIRECT_URI=http://localhost:8000/oauth/naver/callback
TEMIS_LAB_KAKAO_REST_API_KEY=
# Optional when Kakao client-secret protection is disabled in the provider console.
TEMIS_LAB_KAKAO_CLIENT_SECRET=
TEMIS_LAB_KAKAO_REDIRECT_URI=http://localhost:8000/oauth/kakao/callback
# Set true for HTTPS deployment.
TEMIS_LAB_OAUTH_COOKIE_SECURE=false
