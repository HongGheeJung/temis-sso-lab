# ==========================================
# 1. 프로젝트 핵심 민감 정보 및 설정 파일 (절대 업로드 금지)
# ==========================================
.env
.env.*
!.env.example

# 구글 API 키 및 외부 설정 데이터 백업 파일들
*.env

# ==========================================
# 2. 암호학적 인증 키 및 인증서 보관소 (프로젝트 내 var/keys 등)
# ==========================================
**/var/keys/*
*.pem
*.key
*.pub

# ==========================================
# 3. 파이썬 가상환경 및 의존성 패키지 (용량 및 환경 충돌 방지)
# ==========================================
.venv/
venv/
ENV/
env/
python/
lib/
pip-log.txt
pip-delete-this-directory.txt

# ==========================================
# 4. 파이썬 캐시 및 컴파일 파일
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# 5. 데이터베이스 및 로컬 로그 보관 파일
# ==========================================
*.db
*.sqlite3
*.log
log/
logs/

# ==========================================
# 6. 운영체제 및 IDE 개발 도구 설정 파일
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db